meta {
  name: Health Check
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/health
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body: eq OK
}

tests {
  test("returns plain text content type", function() {
    expect(res.getHeader("content-type")).to.contain("text/plain");
  });
}
